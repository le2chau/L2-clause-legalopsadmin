<mvc:View
    controllerName="com.sap.ariba.l2purchaserequisition.controller.PurchaseRequisitionList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <f:DynamicPage id="dynamicPage" class="aribaL2Page" headerExpanded="true" toggleHeaderOnTitleClick="true">

        <f:title>
            <f:DynamicPageTitle>
                <f:breadcrumbs>
                    <Breadcrumbs currentLocationText="Contract Management: Clauses">
                        <links>
                            <Link text="Home" press=".onBreadcrumbPress" />
                        </links>
                    </Breadcrumbs>
                </f:breadcrumbs>
                <f:navigationActions>
                    <Button
                        icon="sap-icon://overflow"
                        type="Transparent"
                        tooltip="More"
                        press=".onOverflow"
                    />
                </f:navigationActions>
                <f:heading>
                    <VariantManagement
                        id="pageVariant"
                        select=".onVariantSelect"
                        save=".onVariantSave"
                        manage=".onVariantManage"
                        selectedKey="standard"
                    >
                        <items>
                            <VariantItem text="All Clauses" key="standard" />
                            <VariantItem text="My Clauses" key="myreqs" />
                            <VariantItem text="Awaiting Approval" key="awaitapproval" />
                        </items>
                    </VariantManagement>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <HBox wrap="Wrap" class="aribaFilterBar">
                    <VBox class="aribaFilterField aribaFilterFieldNoLabel" justifyContent="End">
                        <layoutData>
                            <FlexItemData growFactor="1" shrinkFactor="0" baseSize="0px" />
                        </layoutData>
                        <SearchField
                            id="searchField"
                            placeholder="Search"
                            width="100%"
                            search=".onSearch"
                            liveChange=".onSearch"
                        />
                    </VBox>
                    <VBox class="aribaFilterField" justifyContent="End">
                        <layoutData>
                            <FlexItemData growFactor="1" shrinkFactor="0" baseSize="0px" />
                        </layoutData>
                        <Label text="Status" labelFor="statusFilter" />
                        <MultiComboBox id="statusFilter" placeholder="Any" selectionChange=".onSearch">
                            <items>
                                <core:Item key="Draft" text="Draft" />
                                <core:Item key="Active" text="Active" />
                                <core:Item key="Inactive" text="Inactive" />
                            </items>
                        </MultiComboBox>
                    </VBox>
                    <VBox class="aribaFilterField" justifyContent="End">
                        <layoutData>
                            <FlexItemData growFactor="1" shrinkFactor="0" baseSize="0px" />
                        </layoutData>
                        <Label text="Category" labelFor="categoryFilter" />
                        <MultiComboBox id="categoryFilter" placeholder="Any" selectionChange=".onSearch">
                            <items>
                                <core:Item key="Financial" text="Financial" />
                                <core:Item key="Liability" text="Liability" />
                                <core:Item key="Compliance" text="Compliance" />
                                <core:Item key="IP" text="IP" />
                            </items>
                        </MultiComboBox>
                    </VBox>
                    <VBox class="aribaFilterField" justifyContent="End">
                        <layoutData>
                            <FlexItemData growFactor="1" shrinkFactor="0" baseSize="0px" />
                        </layoutData>
                        <Label text="Governing Law" labelFor="governingLawFilter" />
                        <MultiInput id="governingLawFilter" placeholder="Any" tokenUpdate=".onGoverningLawTokenUpdate" showSuggestion="true">
                            <suggestionItems>
                                <core:Item key="United States" text="United States" />
                                <core:Item key="United Kingdom" text="United Kingdom" />
                                <core:Item key="Germany" text="Germany" />
                                <core:Item key="France" text="France" />
                                <core:Item key="Netherlands" text="Netherlands" />
                                <core:Item key="Singapore" text="Singapore" />
                                <core:Item key="Japan" text="Japan" />
                            </suggestionItems>
                        </MultiInput>
                    </VBox>
                    <VBox class="aribaFilterBarActions" justifyContent="End" alignItems="End">
                        <layoutData>
                            <FlexItemData growFactor="0" shrinkFactor="0" baseSize="0px" />
                        </layoutData>
                        <Button text="Adapt Filters" type="Transparent" press=".onAdaptFilters" />
                    </VBox>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table
                id="prTable"
                items="{display>/items}"
                mode="MultiSelect"
                itemPress=".onItemPress"
                autoPopinMode="true"
                popinLayout="Block"
                hiddenInPopin="None"
                contextualWidth="Inherit"
                class="prTableRowPadding aribaObjectStatusBTokens sapUiSizeCompact sapUiSmallMarginBottom"
            >
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Clauses" titleStyle="H5" wrapping="false" />
                        <Text id="clauseCount" text="{display>/countLabel}" class="aribaL2TableTitleCount" />
                        <ToolbarSeparator />
                        <SegmentedButton id="viewToggle" selectedKey="default" selectionChange=".onViewToggle">
                            <items>
                                <SegmentedButtonItem key="default" text="Default" />
                                <SegmentedButtonItem key="groupByCategory" text="Group by Category" />
                            </items>
                        </SegmentedButton>
                        <ToolbarSpacer />
                        <MenuButton
                            text="Import"
                            type="Emphasized"
                            buttonMode="Split"
                            defaultAction=".onImport"
                        >
                            <menu>
                                <Menu>
                                    <items>
                                        <MenuItem text="Import from File" icon="sap-icon://upload" press=".onImport" />
                                        <MenuItem text="Import from Template" icon="sap-icon://document-text" press=".onImportFromTemplate" />
                                    </items>
                                </Menu>
                            </menu>
                        </MenuButton>
                        <Button text="Copy" type="Transparent" press=".onCopy" />
                        <Button text="Activate" type="Transparent" press=".onActivate" />
                        <Button text="Deactivate" type="Transparent" press=".onDeactivate" />
                        <ToolbarSeparator />
                        <SegmentedButton id="showHideDetails" selectedKey="dtshow" selectionChange=".onShowHideDetails">
                            <items>
                                <SegmentedButtonItem key="dthide" icon="sap-icon://detail-less" tooltip="Compact view" />
                                <SegmentedButtonItem key="dtshow" icon="sap-icon://detail-more" tooltip="Show details" />
                            </items>
                        </SegmentedButton>
                        <ToolbarSeparator />
                        <Button icon="sap-icon://action-settings" tooltip="Column Settings" press=".onColumnSettings" />
                        <ToolbarSeparator />
                        <Button icon="sap-icon://excel-attachment" tooltip="Export" press=".onExport" />
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column
                        width="auto"
                        minScreenWidth="Tablet"
                        demandPopin="true"
                        popinDisplay="Inline"
                        autoPopinWidth="20"
                    >
                        <Text text="Category / Clause / Type" />
                    </Column>
                    <Column
                        id="colCategory"
                        width="10rem"
                        minScreenWidth="Tablet"
                        demandPopin="true"
                        popinDisplay="Inline"
                    >
                        <Text text="Category" />
                    </Column>
                    <Column
                        id="colGoverningLaw"
                        width="12rem"
                        minScreenWidth="Tablet"
                        demandPopin="true"
                        popinDisplay="Inline"
                    >
                        <Text text="Governing Law" />
                    </Column>
                    <Column
                        id="colLanguage"
                        width="10rem"
                        minScreenWidth="Tablet"
                        demandPopin="true"
                        popinDisplay="Inline"
                    >
                        <Text text="Language" />
                    </Column>
                    <Column
                        id="colStatus"
                        width="10rem"
                        minScreenWidth="Tablet"
                        demandPopin="true"
                        popinDisplay="Inline"
                    >
                        <Text text="Status" />
                    </Column>
                    <Column
                        id="colChangedOn"
                        width="9rem"
                        hAlign="End"
                        minScreenWidth="Tablet"
                        demandPopin="true"
                        popinDisplay="Inline"
                    >
                        <Text text="Changed On" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem
                        type="{display>navType}"
                        vAlign="Middle"
                        press=".onItemPress"
                        class="{display>rowClass}"
                    >
                        <cells>
                            <!-- Cell 1: clause row shows expand chevron + title; type row shows token badge -->
                            <HBox alignItems="Center" class="{display>indentClass}">
                                <!-- Clause expand/collapse button (visible on clause rows only) -->
                                <Button
                                    icon="{display>chevronIcon}"
                                    type="Transparent"
                                    press=".onClauseExpand"
                                    tooltip="Expand / Collapse"
                                    visible="{display>isClause}"
                                    class="aribaClauseChevron"
                                />
                                <!-- Clause title + subtitle -->
                                <VBox visible="{display>isClause}" class="aribaClauseTitleBox">
                                    <Title text="{display>title}" level="H6" wrapping="false" class="aribaClauseTitle" />
                                    <Text text="{display>subtitle}" class="aribaClauseSubtitle" />
                                </VBox>
                                <!-- Type name + subtitle (visible on type rows) -->
                                <VBox visible="{display>isType}" class="aribaTypeNameBox">
                                    <ObjectStatus
                                        text="{display>typeName}"
                                        state="{display>typeState}"
                                        inverted="{display>typeInverted}"
                                        class="aribaTypeToken"
                                    />
                                    <Text text="{display>subtitle}" class="aribaClauseSubtitle" />
                                </VBox>
                            </HBox>
                        </cells>
                        <cells>
                            <!-- Cell 2: Category -->
                            <Text text="{display>categoryDisplay}" />
                        </cells>
                        <cells>
                            <!-- Cell 3: Governing Law -->
                            <Text text="{display>governingLaw}" />
                        </cells>
                        <cells>
                            <!-- Cell 4: Language -->
                            <Text text="{display>language}" />
                        </cells>
                        <cells>
                            <!-- Cell 5: Status -->
                            <ObjectStatus
                                text="{display>status}"
                                state="{display>statusState}"
                                inverted="true"
                            />
                        </cells>
                        <cells>
                            <!-- Cell 6: Changed On -->
                            <Text text="{display>changedOn}" textAlign="End" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>

    </f:DynamicPage>
</mvc:View>
