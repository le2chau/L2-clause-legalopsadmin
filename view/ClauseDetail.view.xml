<mvc:View
    controllerName="com.sap.ariba.l2purchaserequisition.controller.ClauseDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true"
>
    <uxap:ObjectPageLayout
        id="clauseDetailPage"
        class="aribaL3Page sapUiSizeCompact"
        showTitleInHeaderContent="false"
        upperCaseAnchorBar="false"
        alwaysShowContentHeader="false"
    >
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>

                <uxap:breadcrumbs>
                    <Breadcrumbs currentLocationText="{app>/selectedTypeName}">
                        <Link text="Home" />
                        <Link text="Contract Management: Clauses" press=".onClose" />
                        <Link text="{app>/selectedClauseTitle}" press=".onClose" />
                    </Breadcrumbs>
                </uxap:breadcrumbs>

                <uxap:expandedHeading>
                    <VBox>
                        <Title text="{app>/selectedTypeName}" level="H2" />
                        <Text text="{app>/selectedClauseTitle}" class="sapUiTinyMarginTop aribaObjectSubtitle" />
                    </VBox>
                </uxap:expandedHeading>

                <uxap:snappedHeading>
                    <VBox>
                        <Title text="{app>/selectedTypeName}" level="H2" />
                        <Text text="{app>/selectedClauseTitle}" class="sapUiTinyMarginTop aribaObjectSubtitle" />
                    </VBox>
                </uxap:snappedHeading>

                <uxap:actions>
                    <Button icon="sap-icon://decline" press=".onClose" tooltip="Close" type="Transparent" />
                    <Button icon="sap-icon://overflow" press=".onMore" tooltip="More Options" type="Transparent" />
                </uxap:actions>

            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
            <HeaderContainer
                backgroundDesign="Transparent"
                showDividers="false"
                height="auto">

                <VBox class="aribaHeaderFacet">
                    <Label text="Status" class="aribaFacetTitle" />
                    <ObjectStatus
                        text="Active"
                        state="Success"
                        icon="sap-icon://information"
                        inverted="true"
                        class="aribaObjStatus sapMObjectStatusLarge"
                    />
                </VBox>

                <VBox class="aribaHeaderFacet">
                    <Label text="Contract Value" class="aribaFacetTitle" />
                    <ObjectNumber
                        number="1,250,000"
                        unit="USD"
                        class="aribaHeaderNumber sapMObjectNumberLarge"
                    />
                </VBox>

                <VBox class="aribaHeaderFacet">
                    <Label text="Key Dates" class="aribaFacetTitle" />
                    <ObjectAttribute title="Effective" text="Jan 1, 2024" />
                    <ObjectAttribute title="Expires" text="Dec 31, 2026" />
                </VBox>

                <VBox class="aribaHeaderFacet">
                    <Label text="Lifecycle Phase" class="aribaFacetTitle" />
                    <layout:HorizontalLayout>
                        <Button icon="sap-icon://create" type="Transparent" tooltip="Draft" />
                        <Button icon="sap-icon://check-availability" type="Transparent" tooltip="Review" />
                        <Button icon="sap-icon://compare" type="Transparent" tooltip="Negotiate" />
                        <Button icon="sap-icon://request" type="Transparent" tooltip="Approve" />
                        <Button icon="sap-icon://accept" type="Transparent" tooltip="Execute" />
                    </layout:HorizontalLayout>
                </VBox>

                <VBox class="aribaHeaderFacet">
                    <Label text="Time to Expiry" class="aribaFacetTitle" />
                    <ProgressIndicator
                        percentValue="75"
                        displayValue="90 days remaining"
                        state="Warning"
                        width="14rem"
                    />
                </VBox>

                <VBox class="aribaHeaderFacet">
                    <Label text="Parties" class="aribaFacetTitle" />
                    <ObjectAttribute title="Buyer" text="Acme Corporation" />
                    <ObjectAttribute title="Supplier" text="Global Supplies Inc." />
                </VBox>

                <VBox class="aribaHeaderFacet">
                    <Label text="Category" class="aribaFacetTitle" />
                    <ObjectAttribute title="Type" text="{app>/selectedTypeVariant}" />
                    <ObjectAttribute title="Clause" text="{app>/selectedClauseTitle}" />
                </VBox>

            </HeaderContainer>
        </uxap:headerContent>

        <uxap:sections>

            <!-- Overview -->
            <uxap:ObjectPageSection id="detailSectionOverview" title="Overview">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="">
                        <form:SimpleForm
                            editable="false"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="12"
                            labelSpanL="12"
                            labelSpanM="12"
                            labelSpanS="12"
                            emptySpanXL="0"
                            emptySpanL="0"
                            emptySpanM="0"
                            emptySpanS="0"
                            columnsXL="1"
                            columnsL="1"
                            columnsM="1"
                        >
                            <form:content>
                                <Label text="Clause Title" />
                                <Text text="{app>/selectedClauseTitle}" />
                                <Label text="Type" />
                                <Text text="{app>/selectedTypeName}" />
                                <Label text="Contract Hierarchy" />
                                <Text text="Master Agreement > Work Order > Statement of Work" />
                                <Label text="Contract Description" />
                                <Text text="This clause defines the standard terms applicable to all transactions under this agreement. It establishes the baseline conditions for compliance and performance measurement." />
                            </form:content>
                        </form:SimpleForm>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Contract Template -->
            <uxap:ObjectPageSection id="detailSectionTemplate" title="Contract Template">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="">
                        <Panel class="aribaTemplatePanel">
                            <content>
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMargin">
                                    <HBox alignItems="Center">
                                        <Avatar
                                            icon="sap-icon://crm-service-manager"
                                            displayShape="Square"
                                            displaySize="M"
                                            backgroundColor="TileIcon"
                                            class="sapUiSmallMarginEnd aribaTemplateAvatar"
                                        />
                                        <VBox>
                                            <Title text="Standard Clause Template v2.1" level="H5" />
                                            <Text text="CT-2024-001" class="sapUiTinyMarginTop" />
                                            <Text text="Approved template for standard commercial agreements including payment and liability clauses." class="sapUiTinyMarginTop" width="40rem" />
                                        </VBox>
                                    </HBox>
                                    <Button
                                        text="Change Template"
                                        type="Transparent"
                                        press=".onChangeTemplate"
                                    />
                                </HBox>
                            </content>
                        </Panel>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Legal Agreement -->
            <uxap:ObjectPageSection id="detailSectionLegalAgreement" title="Legal Agreement">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="">
                        <VBox width="100%">
                            <layout:Grid defaultSpan="L3 M6 S12" class="sapUiSmallMarginTop sapUiSmallMarginBottom">
                                <layout:content>
                                    <VBox>
                                        <Label text="Governing Law" />
                                        <Text text="New York, USA" class="sapUiTinyMarginTop" />
                                    </VBox>
                                    <VBox>
                                        <Label text="Language" />
                                        <Text text="English" class="sapUiTinyMarginTop" />
                                    </VBox>
                                </layout:content>
                            </layout:Grid>
                            <Panel class="aribaTemplatePanel sapUiMediumMarginTop" width="100%">
                                <content>
                                    <IllustratedMessage
                                        illustrationType="sapIllus-SearchEarth"
                                        title="No legal agreement added yet"
                                        description="You can add a legal agreement either by choosing to create a new agreement from a template or by uploading an existing legal agreement file."
                                    >
                                        <additionalContent>
                                            <Button text="Choose a Template" type="Emphasized" press=".onChooseTemplate" />
                                            <Button text="Upload Agreement" type="Default" press=".onUploadAgreement" class="sapUiTinyMarginBegin" />
                                        </additionalContent>
                                    </IllustratedMessage>
                                </content>
                            </Panel>
                        </VBox>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Attachments -->
            <uxap:ObjectPageSection id="detailSectionAttachments" title="Attachments (0)">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="">
                        <IllustratedMessage
                            illustrationType="sapIllus-NoData"
                            title="No Attachments"
                            description="Upload files to attach them to this clause."
                        />
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Compliance Terms -->
            <uxap:ObjectPageSection id="detailSectionComplianceTerms" title="Compliance Terms">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="Consumption and Integration">
                        <VBox width="100%">
                            <layout:Grid defaultSpan="L3 M6 S12" class="sapUiSmallMarginTop sapUiSmallMarginBottom">
                                <layout:content>
                                    <VBox>
                                        <Label text="Consumption Method" />
                                        <Text text="Direct Purchase" class="sapUiTinyMarginTop" />
                                    </VBox>
                                </layout:content>
                            </layout:Grid>
                            <layout:Grid defaultSpan="L3 M6 S12" class="sapUiSmallMarginBottom">
                                <layout:content>
                                    <VBox>
                                        <Label text="Purchasing Organization" />
                                        <Text text="AMER Procurement" class="sapUiTinyMarginTop" />
                                    </VBox>
                                    <VBox>
                                        <Label text="Company Code" />
                                        <Text text="1000" class="sapUiTinyMarginTop" />
                                    </VBox>
                                    <VBox>
                                        <Label text="Payment Terms" />
                                        <Text text="Net 30" class="sapUiTinyMarginTop" />
                                    </VBox>
                                </layout:content>
                            </layout:Grid>
                        </VBox>
                    </uxap:ObjectPageSubSection>
                    <uxap:ObjectPageSubSection title="Terms and Limits">
                        <layout:Grid defaultSpan="L3 M6 S12" class="sapUiSmallMarginTop sapUiSmallMarginBottom">
                            <layout:content>
                                <VBox>
                                    <Label text="Consumption Scope" />
                                    <Text text="Global" class="sapUiTinyMarginTop" />
                                </VBox>
                                <VBox>
                                    <Label text="Limit Type" />
                                    <Text text="Maximum Value" class="sapUiTinyMarginTop" />
                                </VBox>
                                <VBox>
                                    <Label text="Maximum Limit / Currency" />
                                    <Text text="5,000,000 / USD" class="sapUiTinyMarginTop" />
                                </VBox>
                            </layout:content>
                        </layout:Grid>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Items -->
            <uxap:ObjectPageSection id="detailSectionItems" title="Items (0)">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="">
                        <IllustratedMessage illustrationType="sapIllus-NoData" title="No Items" description="No items have been added to this clause." />
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Teams -->
            <uxap:ObjectPageSection id="detailSectionTeams" title="Teams (0)">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="">
                        <IllustratedMessage illustrationType="sapIllus-NoData" title="No Teams" description="No teams have been assigned to this clause." />
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Tasks -->
            <uxap:ObjectPageSection id="detailSectionTasks" title="Tasks (0)">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="">
                        <IllustratedMessage illustrationType="sapIllus-NoData" title="No Tasks" description="No tasks have been created for this clause." />
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
