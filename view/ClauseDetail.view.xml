<mvc:View
    controllerName="com.sap.ariba.l2purchaserequisition.controller.ClauseDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:suite="sap.suite.ui.commons"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true"
>
    <uxap:ObjectPageLayout
        id="clauseDetailPage"
        class="aribaL3Page sapUiSizeCompact"
        showTitleInHeaderContent="false"
        upperCaseAnchorBar="false"
        alwaysShowContentHeader="false"
    >
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>

                <uxap:breadcrumbs>
                    <Breadcrumbs currentLocationText="{app>/selectedPageTitle}">
                        <Link text="Home" />
                        <Link text="Contract Management: Clauses" press=".onClose" />
                    </Breadcrumbs>
                </uxap:breadcrumbs>

                <uxap:expandedHeading>
                    <VBox>
                        <Title text="{app>/selectedPageTitle}" level="H2" />
                        <Text text="{app>/selectedClauseId}" class="sapUiTinyMarginTop aribaObjectSubtitle" />
                    </VBox>
                </uxap:expandedHeading>

                <uxap:snappedHeading>
                    <VBox>
                        <Title text="{app>/selectedPageTitle}" level="H2" />
                        <Text text="{app>/selectedClauseId}" class="sapUiTinyMarginTop aribaObjectSubtitle" />
                    </VBox>
                </uxap:snappedHeading>

                <uxap:actions>
                    <Button icon="sap-icon://decline" press=".onClose" tooltip="Close" type="Transparent" />
                    <Button icon="sap-icon://overflow" press=".onMore" tooltip="More Options" type="Transparent" />
                </uxap:actions>

            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
            <HeaderContainer
                backgroundDesign="Transparent"
                showDividers="false"
                height="auto">

                <VBox class="aribaHeaderFacet">
                    <Label text="Status" class="aribaFacetTitle" />
                    <ObjectStatus
                        text="Active"
                        state="Success"
                        icon="sap-icon://information"
                        inverted="true"
                        class="aribaObjStatus sapMObjectStatusLarge"
                    />
                </VBox>

                <VBox class="aribaHeaderFacet">
                    <Label text="Linked Templates" class="aribaFacetTitle" />
                    <Tokenizer width="300px" editable="false">
                        <Token text="Statement of Work Template" />
                        <Token text="Service Agreement Template" />
                        <Token text="Master Services Agreement" />
                    </Tokenizer>
                </VBox>

                <VBox class="aribaHeaderFacet">
                    <Label text="Lifecycle Phase" class="aribaFacetTitle" />
                    <suite:MicroProcessFlow>
                        <suite:content>
                            <suite:MicroProcessFlowItem icon="sap-icon://create"             title="Draft"     state="Success" />
                            <suite:MicroProcessFlowItem icon="sap-icon://check-availability" title="Review"    state="Success" />
                            <suite:MicroProcessFlowItem icon="sap-icon://compare"            title="Negotiate" state="Warning" />
                            <suite:MicroProcessFlowItem icon="sap-icon://request"            title="Approve"   state="None" />
                            <suite:MicroProcessFlowItem icon="sap-icon://accept"             title="Execute"   state="None" />
                        </suite:content>
                    </suite:MicroProcessFlow>
                </VBox>

                <VBox class="aribaHeaderFacet" width="280px">
                    <Label text="Description" class="aribaFacetTitle" />
                    <Text text="{app>/selectedDescription}" maxLines="5" />
                </VBox>

                <VBox class="aribaHeaderFacet">
                    <Label text="Governing Law" class="aribaFacetTitle" />
                    <ObjectAttribute title="Governing Law" text="{app>/selectedGoverningLaw}" />
                    <ObjectAttribute title="Language"      text="{app>/selectedLanguage}" />
                </VBox>

                <VBox class="aribaHeaderFacet">
                    <Label text="Audit" class="aribaFacetTitle" />
                    <ObjectAttribute title="Created By" text="{app>/selectedCreatedBy}" active="true" press=".onCreatedByPress" />
                    <ObjectAttribute title="Created On" text="{app>/selectedCreatedOn}" />
                    <ObjectAttribute title="Changed By" text="{app>/selectedChangedBy}" active="true" press=".onChangedByPress" />
                    <ObjectAttribute title="Changed On" text="{app>/selectedChangedOn}" />
                </VBox>

            </HeaderContainer>
        </uxap:headerContent>

        <uxap:sections>

            <!-- Overview -->
            <uxap:ObjectPageSection id="detailSectionOverview" title="Overview">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="">
                        <form:SimpleForm
                            editable="false"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="12"
                            labelSpanL="12"
                            labelSpanM="12"
                            labelSpanS="12"
                            emptySpanXL="0"
                            emptySpanL="0"
                            emptySpanM="0"
                            emptySpanS="0"
                            columnsXL="1"
                            columnsL="1"
                            columnsM="1"
                        >
                            <form:content>
                                <Label text="Type" />
                                <Text text="{app>/selectedTypeName}" />
                                <Label text="Clause Language" />
                                <FormattedText class="aribaClauseLanguage" htmlText="{app>/selectedClauseLanguage}" />
                            </form:content>
                        </form:SimpleForm>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
